# Copiază fișierul ca .env.local și completează valorile din Supabase.
# .env.local nu ajunge pe GitHub. Nu pune niciodată chei reale în acest fișier.

# Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Doar pe server. Nu o folosi niciodată cu prefixul NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Connect -> Direct -> Session pooler (pentru migrări: pnpm db:push)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<parola>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Generată de pnpm db:seed: parola conturilor demo
DEMO_PASSWORD=
